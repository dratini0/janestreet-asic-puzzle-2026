<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description/>
 <version/>
 <category>d25</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name>d25_scripts</group-name>
 <menu-path>tools_menu.d25.end</menu-path>
 <interpreter>dsl</interpreter>
 <dsl-interpreter-name>d25-dsl-xml</dsl-interpreter-name>
 <text># KLayout 2.5D script for SKY130A GDSs.

# Source: https://github.com/TinyTapeout/tinytapeout_gds_viewer/blob/main/src/pdk_layers.js
# JS to generate: console.log(sky130A.map((i) =&gt; `z(input(${i.layer_number}, ${i.layer_datatype}), ${i.zmin}..${i.zmax}, name: "${i.name}", color: 0x${Math.round(i.color[0] * 255).toString(16).padStart(2, 0)}${Math.round(i.color[1] * 255).toString(16).padStart(2, 0)}${Math.round(i.color[2] * 255).toString(16).padStart(2, 0)})\n`).join(""))

# Is the z scale even remotely realistic? Probably not, but I don't care.

z(input(235, 4), -2..0, name: "substrate", color: 0x333333)
z(input(64, 20), -2..0, name: "nwell", color: 0x666666)
z(input(65, 20), -0.5..0.01, name: "diff", color: 0xe6e6e6)
z(input(66, 20), 0..0.18, name: "poly", color: 0xbf5975)
z(input(66, 44), 0..0.936, name: "licon", color: 0x333333)
z(input(67, 20), 0.936..1.136, name: "li1", color: 0xffcf8c)
z(input(67, 44), 1.011..1.376, name: "mcon", color: 0x333333)
z(input(68, 20), 1.376..1.736, name: "met1", color: 0x2961d4)
z(input(68, 44), 1.73..2, name: "via", color: 0x333333)
z(input(69, 20), 2..2.36, name: "met2", color: 0xa6bfe6)
z(input(69, 44), 2.36..2.786, name: "via2", color: 0x333333)
z(input(70, 20), 2.786..3.631, name: "met3", color: 0x339edb)
z(input(70, 44), 3.631..4.0211, name: "via3", color: 0x333333)
z(input(89, 44), 3.731..3.931, name: "capm", color: 0x3352db)
z(input(71, 20), 4.0211..4.8661, name: "met4", color: 0x261c61)
z(input(97, 44), 4.121099999999999..4.3210999999999995, name: "cap2m", color: 0x260061)
z(input(71, 44), 4.8661..5.371, name: "via4", color: 0x333333)
z(input(72, 20), 5.371..6.6311, name: "met5", color: 0x669999)
</text>
</klayout-macro>
